rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isCampaignOwner(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerId == request.auth.uid;
    }

    // Users Collection (/users/{uid})
    // - Contains user document with role: 'campaigner' | 'creator' | 'reviewer'
    // - Authenticated users can read their own profile. Reviewers can read user profiles.
    // - Users can create/update their profile for their own uid.
    match /users/{uid} {
      allow read: if isAuthenticated() && (
        request.auth.uid == uid ||
        getUserRole(request.auth.uid) == 'reviewer'
      );
      allow create, update: if isAuthenticated() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Campaigns Collection (/campaigns/{campaignId})
    // - Create/Update/Delete: ONLY the owning campaigner (getUserRole(request.auth.uid) == 'campaigner' && request.auth.uid == ownerId)
    // - Read: Reviewers, Campaign owners, or assigned Creators (getUserRole(request.auth.uid) == 'creator' && ('assignedCreators' in resource.data && request.auth.uid in resource.data.assignedCreators))
    // - Writers: Creators and reviewers are strictly DENIED write access
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated() && (
        getUserRole(request.auth.uid) == 'reviewer' ||
        resource.data.ownerId == request.auth.uid ||
        (getUserRole(request.auth.uid) == 'creator' && ('assignedCreators' in resource.data && request.auth.uid in resource.data.assignedCreators))
      );

      allow create: if isAuthenticated()
        && getUserRole(request.auth.uid) == 'campaigner'
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated()
        && getUserRole(request.auth.uid) == 'campaigner'
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;

      allow delete: if isAuthenticated()
        && getUserRole(request.auth.uid) == 'campaigner'
        && resource.data.ownerId == request.auth.uid;

      // Audit Trail (/campaigns/{campaignId}/audit_trail/{versionId})
      // - Read: Reviewers and the owning campaigner
      // - Create: Creator matching the report creatorId or owning campaigner / server logic
      // - Update/Delete: Fully denied (immutable audit log)
      match /audit_trail/{versionId} {
        allow read: if isAuthenticated() && (
          getUserRole(request.auth.uid) == 'reviewer' ||
          (getUserRole(request.auth.uid) == 'campaigner' && isCampaignOwner(campaignId))
        );

        allow create: if isAuthenticated() && (
          (getUserRole(request.auth.uid) == 'creator' && request.resource.data.creatorId == request.auth.uid) ||
          (getUserRole(request.auth.uid) == 'campaigner' && isCampaignOwner(campaignId))
        );

        allow update, delete: if false;
      }
    }

    // Regulatory Entries (/regulatory_entries/{entryId})
    // - Read: All authenticated users
    // - Create/Update/Delete: ONLY users with role 'reviewer'
    match /regulatory_entries/{entryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated()
        && getUserRole(request.auth.uid) == 'reviewer';
    }

    // Compliance Reports (/compliance_reports/{reportId})
    // - Create: Creators can create a report ONLY for themselves (creatorId == request.auth.uid)
    // - Read: Creators can read their own reports, Reviewers can read all reports, Campaigners can read reports for their owned campaigns
    // - Update: Reviewers can update ONLY the reviewerDecision field (and updatedAt timestamp). AI reasoning, findings, and content remain immutable.
    // - Delete: Denied to preserve compliance records
    match /compliance_reports/{reportId} {
      allow read: if isAuthenticated() && (
        (getUserRole(request.auth.uid) == 'creator' && resource.data.creatorId == request.auth.uid) ||
        getUserRole(request.auth.uid) == 'reviewer' ||
        (getUserRole(request.auth.uid) == 'campaigner' && 
          'campaignId' in resource.data && 
          isCampaignOwner(resource.data.campaignId))
      );

      allow create: if isAuthenticated()
        && getUserRole(request.auth.uid) == 'creator'
        && request.resource.data.creatorId == request.auth.uid;

      allow update: if isAuthenticated()
        && getUserRole(request.auth.uid) == 'reviewer'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewerDecision', 'updatedAt']);

      allow delete: if false;
    }
  }
}
